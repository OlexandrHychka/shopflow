{
  "name": "@shopflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test": "pnpm test:unit && pnpm test:component"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "testcontainers": "12.2.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
